SITE_DESCRIPTION=Türkiye ve dünyadan son dakika haberleri, güncel gelişmeler.
# Haberlerde yazar olarak görünecek isim
SITE_AUTHOR=Haber Merkezi

# ===== Künye (Basın Kanunu gereği zorunlu) =====
KUNYE_SAHIBI=Ad Soyad
KUNYE_SORUMLU_MUDUR=Ad Soyad
KUNYE_ADRES=Mahalle, Cadde No, İlçe/İl
KUNYE_EPOSTA=iletisim@ornekhaber.com
KUNYE_TELEFON=
KUNYE_YER_SAGLAYICI=Hetzner Online GmbH

# ===== Güvenlik (uzun, rastgele değerler kullan: openssl rand -hex 32) =====
ADMIN_PASSWORD=degistir
ADMIN_SECRET=degistir-en-az-32-karakter-rastgele-deger
API_TOKEN=degistir-n8n-ile-site-arasindaki-anahtar

# ===== Claude API =====
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5

# ===== Yayın kuralları =====
# Düşük riskli haberler kaç dakika sonra otomatik yayınlansın
AUTO_PUBLISH_DELAY_MIN=5
# Düşük riskli son dakika haberleri beklemeden yayınlansın mı
BREAKING_AUTO_PUBLISH=true
# Her 15 dakikalık turda en fazla kaç haber yazılsın
MAX_ARTICLES_PER_RUN=3

# ===== Google AdSense (onay geldikten sonra doldur) =====
ADSENSE_CLIENT=
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_ARTICLE=

# ===== n8n ve bildirimler =====
