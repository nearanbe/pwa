# Onay bildirimlerinin geleceği senin kişisel sohbet ID'n
TELEGRAM_ADMIN_CHAT_ID=
# Haberlerin paylaşılacağı kanal (@kanaladi veya -100...)
TELEGRAM_CHANNEL_ID=
FB_PAGE_ID=
