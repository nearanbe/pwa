{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "base", "name": "Beyaz", "color": "#FFFFFF" },
				{ "slug": "surface", "name": "Açık Yeşil Zemin", "color": "#EEF6F0" },
				{ "slug": "soft", "name": "Pastel Yeşil", "color": "#CFE6D6" },
				{ "slug": "primary", "name": "Ana Yeşil", "color": "#4A7A5E" },
				{ "slug": "primary-dark", "name": "Koyu Yeşil", "color": "#2F5A43" },
				{ "slug": "cream", "name": "Krem", "color": "#FAF7F0" },
				{ "slug": "contrast", "name": "Metin", "color": "#22312A" },
				{ "slug": "muted", "name": "Açık Metin", "color": "#5B6B63" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw"],
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "clamp(1.25rem, 2.5vw, 1.75rem)" },
				{ "slug": "40", "name": "L", "size": "clamp(1.75rem, 4vw, 2.75rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(2.5rem, 6vw, 4.5rem)" },
				{ "slug": "60", "name": "XXL", "size": "clamp(3.5rem, 9vw, 7rem)" }
			]
		},
		"typography": {
			"customFontSize": true,
			"fluid": true,
			"defaultFontSizes": false,
			"fontSizes": [
				{ "slug": "small", "name": "Küçük", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Normal", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Büyük", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Çok Büyük", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Başlık", "size": "2.75rem", "fluid": { "min": "2rem", "max": "3.25rem" } }
			],
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Nunito",
					"fontFamily": "Nunito, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Nunito",
							"fontStyle": "normal",
							"fontWeight": "200 1000",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/nunito-latin-ext-wght-normal.woff2"],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Nunito",
							"fontStyle": "normal",
							"fontWeight": "200 1000",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/nunito-latin-wght-normal.woff2"],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "heading",
					"name": "Lora",
					"fontFamily": "Lora, Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Lora",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/lora-latin-ext-wght-normal.woff2"],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Lora",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/lora-latin-wght-normal.woff2"],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Yumuşak", "shadow": "0 6px 24px rgba(34, 49, 42, 0.08)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--preset--spacing--20)",
				"right": "var(--wp--preset--spacing--20)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary-dark)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--primary-dark)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.25"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "999px" },
				"spacing": {
					"padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.6rem", "right": "1.6rem" }
				},
				"typography": { "fontWeight": "700", "fontSize": "var(--wp--preset--font-size--medium)" },
				":hover": {
					"color": { "background": "var(--wp--preset--color--primary-dark)" }
				},
				":focus": {
					"color": { "background": "var(--wp--preset--color--primary-dark)" }
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "600" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--contrast)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--primary-dark)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--primary-dark)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--soft)" }
			},
			"core/quote": {
				"border": {
					"left": { "color": "var(--wp--preset--color--primary)", "width": "4px", "style": "solid" }
				},
				"spacing": { "padding": { "left": "1.25rem" } },
				"typography": { "fontStyle": "italic" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Üst Bölüm", "area": "header" },
		{ "name": "footer", "title": "Alt Bölüm", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-hizmet", "title": "Hizmet Sayfası", "postTypes": ["page"] },
		{ "name": "page-genis", "title": "Geniş Sayfa (başlıksız)", "postTypes": ["page"] }
	]
}
